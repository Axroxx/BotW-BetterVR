{
  "file_format_version": "1.1.2",
  "layer": {
    "name": "VK_LAYER_CREMENTIF_bettervr",
    "type": "GLOBAL",
    "library_path": "${BETTERVR_LAYER_DLL_PATH}",
    "api_version": "1.2.0",
    "implementation_version": "1",
    "description": "Vulkan layer used to breath some VR into BotW for Cemu, using OpenXR!",
    "enable_environment": {
      "${BETTERVR_LAYER_ENABLE_ENV}": "1"
    },
    "disable_environment": {
      "${BETTERVR_LAYER_DISABLE_ENV}": "1"
    },
    "functions": {
      "vkNegotiateLoaderLayerInterfaceVersion": "VRLayer_NegotiateLoaderLayerInterfaceVersion",
      "vkGetInstanceProcAddr": "VRLayer_GetInstanceProcAddr",
      "vkGetDeviceProcAddr": "VRLayer_GetDeviceProcAddr"
    }
  }
}
